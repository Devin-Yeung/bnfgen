// Grammar recognition for the Bnfgen source language.
//
// This file owns the LALRPOP grammar; it is generated into a private module
// and its types never cross the crate interface. Recognition here is pure
// range collection: actions only package byte ranges into the private
// records in `crate::records`. No decoding, no validation, no fallible
// work — those belong downstream.
//
// Current status: every construct accepted by the legacy grammar is
// recognized as raw syntax. Recovery productions will arrive later.

use crate::records::{
    AlternativeRecord, NonTerminalRecord, RepeatRecord, RuleRecord, SymbolRecord,
};
use crate::token::TokenKind;
use std::ops::Range;

grammar;

// Bridge the lexer: locations are byte offsets into the retained source.
// The error type exists only to satisfy LALRPOP's signature — no action in
// this grammar can fail.
extern {
    type Location = usize;
    type Error = &'static str;

    enum TokenKind {
        "<" => TokenKind::LAngle,
        ">" => TokenKind::RAngle,
        "{" => TokenKind::LBrace,
        "}" => TokenKind::RBrace,
        "(" => TokenKind::LParen,
        ")" => TokenKind::RParen,
        "::=" => TokenKind::Def,
        ":" => TokenKind::Colon,
        "," => TokenKind::Comma,
        "|" => TokenKind::Or,
        ";" => TokenKind::Semi,
        "re" => TokenKind::Re,
        "id" => TokenKind::Id,
        "str" => TokenKind::Str,
        "int" => TokenKind::Int,
    }
}

pub Document: Vec<RuleRecord> = <rules: Rule*> => rules;

Rule: RuleRecord = {
    <l: @L> <lhs: NonTerminal> "::=" <alts: Alternatives> ";" <r: @R> =>
        RuleRecord { span: l..r, lhs, alts },
};

NonTerminal: NonTerminalRecord = {
    <l: @L> "<" <nl: @L> "id" <nr: @R> ">" <r: @R> =>
        NonTerminalRecord { span: l..r, name: nl..nr, ty: None },

    <l: @L> "<" <nl: @L> "id" <nr: @R> ":" <tl: @L> "str" <tr: @R> ">" <r: @R> =>
        NonTerminalRecord { span: l..r, name: nl..nr, ty: Some(tl..tr) },
};

// Zero-or-more `|`-separated items, with or without a trailing `|`.
// Mirrors the legacy grammar's `Or` macro so alternative acceptance does
// not drift during migration.
Or<T>: Vec<T> = <mut v:(<T> "|")*> <e:T?> => match e {
    None => v,
    Some(e) => {
        v.push(e);
        v
    }
};

Alternatives: Vec<AlternativeRecord> = Or<Alternative>;

Alternative: AlternativeRecord = {
    <l: @L> <weight: Integer?> <symbols: Symbol+> <repeat: Repeat?> <r: @R> =>
        AlternativeRecord { span: l..r, weight, symbols, repeat },
};

Integer: Range<usize> = <l: @L> "int" <r: @R> => l..r;

Repeat: RepeatRecord = {
    <l: @L> "{" <lower: Integer> "}" <r: @R> =>
        RepeatRecord { span: l..r, lower, comma: None, upper: None },

    <l: @L> "{" <lower: Integer> <cl: @L> "," <cr: @R> <upper: Integer?> "}" <r: @R> =>
        RepeatRecord { span: l..r, lower, comma: Some(cl..cr), upper },
};

Symbol: SymbolRecord = {
    <l: @L> "str" <r: @R> =>
        SymbolRecord::Terminal { span: l..r },

    <non_terminal: NonTerminal> => SymbolRecord::NonTerminal(non_terminal),

    <l: @L> "re" "(" <pl: @L> "str" <pr: @R> ")" <r: @R> =>
        SymbolRecord::Regex { span: l..r, pattern: pl..pr },
};
